backend/.venv/
backend/venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# ── Environment / secrets ──────────────────────────────
.env
backend/.env
*.env.local
*.env.*.local

